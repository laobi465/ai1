          "assignments": [
            {
              "id": "src-list",
              "name": "sources",
              "type": "array",
              "value": "[{\"name\":\"Dev.to\",\"url\":\"https://dev.to/feed\",\"category\":\"Developer News\"},{\"name\":\"CSS-Tricks\",\"url\":\"https://css-tricks.com/feed/\",\"category\":\"Web Development\"},{\"name\":\"Smashing Magazine\",\"url\":\"https://www.smashingmagazine.com/feed/\",\"category\":\"Web Development\"},{\"name\":\"SitePoint\",\"url\":\"https://www.sitepoint.com/feed/\",\"category\":\"Web Development\"},{\"name\":\"Hacker News\",\"url\":\"https://hnrss.org/frontpage\",\"category\":\"Developer News\"},{\"name\":\"Product Hunt\",\"url\":\"https://www.producthunt.com/feed\",\"category\":\"Product Reviews\"},{\"name\":\"TechCrunch\",\"url\":\"https://techcrunch.com/feed/\",\"category\":\"Tech News\"},{\"name\":\"The Verge\",\"url\":\"https://www.theverge.com/rss/index.xml\",\"category\":\"Tech News\"}]"
            }
          ]
        }
      }
