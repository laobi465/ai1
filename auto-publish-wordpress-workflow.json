{
  "name": "自动抓取+AI优化+发布WordPress文章",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "hours",
              "hoursInterval": 6
            }
          ]
        }
      },
      "id": "node-schedule",
      "name": "Schedule Trigger",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.3,
      "position": [0, 0]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "https://www.example.com/your-article",
        "responseFormat": "text",
        "options": {}
      },
      "id": "node-http",
      "name": "HTTP Request",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [220, 0]
    },
    {
      "parameters": {
        "sourceData": "json",
        "dataPropertyName": "data",
        "extractionValues": {
          "values": [
            {
              "key": "title",
              "selector": "h1",
              "returnValue": "text"
            },
            {
              "key": "content",
              "selector": "article",
              "returnValue": "text"
            }
          ]
        }
      },
      "id": "node-html",
      "name": "HTML Extract",
      "type": "n8n-nodes-base.htmlExtract",
      "typeVersion": 1,
      "position": [440, 0]
    },
    {
      "parameters": {
        "promptType": "define",
        "text": "={{ $json.title + '\\n\\n' + $json.content }}",
        "hasOutputParser": true,
        "options": {
          "systemMessage": "你是一位资深的中文内容编辑与SEO/GEO优化专家。请对用户提供的原始文章进行专业润色，并做SEO与GEO优化，使内容更专业、易读，利于搜索引擎和AI搜索（如Perplexity、ChatGPT Search）收录。请严格按照Structured Output Parser定义的JSON Schema输出：title（优化后的标题）、slug（URL友好别名）、excerpt（约120字SEO摘要）、content（优化后的正文，使用HTML格式，包含恰当的h2小标题、段落、列表和加粗，自然融入核心关键词）、tags（3-5个主题标签数组）。只输出合法JSON，不要添加额外说明。"
        }
      },
      "id": "node-agent",
      "name": "AI Agent",
      "type": "@n8n/n8n-nodes-langchain.agent",
      "typeVersion": 3.1,
      "position": [680, 0]
    },
    {
      "parameters": {
        "model": {
          "__rl": true,
          "mode": "id",
          "value": "gpt-4o-mini"
        },
        "options": {
          "temperature": 0.7
        }
      },
      "id": "node-model",
      "name": "OpenAI Chat Model",
      "type": "@n8n/n8n-nodes-langchain.lmChatOpenAi",
      "typeVersion": 1.3,
      "position": [540, -220],
      "credentials": {
        "openAiApi": {
          "name": "OpenAI account"
        }
      }
    },
    {
      "parameters": {
        "schemaType": "manual",
        "jsonSchema": {
          "type": "object",
          "properties": {
            "title": {
              "type": "string"
            },
            "slug": {
              "type": "string"
            },
            "excerpt": {
              "type": "string"
            },
            "content": {
              "type": "string"
            },
            "tags": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          "required": ["title", "slug", "excerpt", "content", "tags"]
        }
      },
      "id": "node-parser",
      "name": "Structured Output Parser",
      "type": "@n8n/n8n-nodes-langchain.outputParserStructured",
      "typeVersion": 1.3,
      "position": [540, 220]
    },
    {
      "parameters": {
        "resource": "post",
        "operation": "create",
        "authType": "basicAuth",
        "title": "={{ $json.title }}",
        "additionalFields": {
          "content": "={{ $json.content }}",
          "slug": "={{ $json.slug }}",
          "excerpt": "={{ $json.excerpt }}",
          "status": "publish",
          "commentStatus": "open"
        }
      },
      "id": "node-wp",
      "name": "WordPress",
      "type": "n8n-nodes-base.wordpress",
      "typeVersion": 1,
      "position": [940, 0],
      "credentials": {
        "wordpressApi": {
          "name": "WordPress account"
        }
      }
    }
  ],
  "connections": {
    "Schedule Trigger": {
      "main": [
        [
          {
            "node": "HTTP Request",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "HTTP Request": {
      "main": [
        [
          {
            "node": "HTML Extract",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "HTML Extract": {
      "main": [
        [
          {
            "node": "AI Agent",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "OpenAI Chat Model": {
      "ai_languageModel": [
        [
          {
            "node": "AI Agent",
            "type": "ai_languageModel",
            "index": 0
          }
        ]
      ]
    },
    "Structured Output Parser": {
      "ai_outputParser": [
        [
          {
            "node": "AI Agent",
            "type": "ai_outputParser",
            "index": 0
          }
        ]
      ]
    },
    "AI Agent": {
      "main": [
        [
          {
            "node": "WordPress",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  },
  "pinData": {},
  "meta": {
    "templateCredsSetupCompleted": false
  }
}